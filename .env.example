# URL del sitio para redirects de Auth y OAuth de correos
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth Gmail (Cloud Console → APIs → Gmail API + OAuth client Web)
# URI de redirección: http://localhost:3000/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# OAuth Microsoft Graph (Azure → App registration → Mail.Read + offline_access)
# URI de redirección: http://localhost:3000/api/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback

# AES-256 para tokens del buzón. Genera un valor largo y único.
EMAIL_OAUTH_TOKEN_SECRET=
